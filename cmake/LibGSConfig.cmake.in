@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(LibGS_ASIO_PROVIDER "@LIBGS_ASIO_PROVIDER@")
set(LibGS_SPDLOG_PROVIDER "@LIBGS_SPDLOG_PROVIDER@")
set(LibGS_OPENSSL_INSTALL_PREFIX "@LIBGS_OPENSSL_INSTALL_PREFIX@")
set(LibGS_VERSION "@PROJECT_VERSION@")

# Resolve component availability before looking for dependencies.  A missing
# component must not be obscured by an unrelated dependency failure.
set(LibGS_core_FOUND TRUE)
set(LibGS_coro_FOUND @LIBGS_BUILD_CORO@)
set(LibGS_http_FOUND @LIBGS_BUILD_HTTP@)
set(LibGS_websocket_FOUND @LIBGS_BUILD_WEBSOCKET@)
set(LibGS_utils_FOUND @LIBGS_BUILD_UTILITIES@)

set(_libgs_missing_components)
foreach(_libgs_component IN LISTS LibGS_FIND_COMPONENTS)
	if (NOT DEFINED LibGS_${_libgs_component}_FOUND)
		set(LibGS_${_libgs_component}_FOUND FALSE)
	endif ()

	if (NOT LibGS_${_libgs_component}_FOUND AND
		LibGS_FIND_REQUIRED_${_libgs_component})
		list(APPEND _libgs_missing_components ${_libgs_component})
	endif ()
endforeach()

if (_libgs_missing_components)
	list(JOIN _libgs_missing_components ", " _libgs_missing_components_text)
	set(LibGS_NOT_FOUND_MESSAGE
		"Required LibGS components are unavailable: ${_libgs_missing_components_text}"
	)
endif ()

set(LibGS_FOUND TRUE)
check_required_components(LibGS)

if (NOT LibGS_FOUND)
	unset(_libgs_component)
	unset(_libgs_missing_components)
	unset(_libgs_missing_components_text)
	return()
endif ()

if (LibGS_ASIO_PROVIDER STREQUAL "BOOST")
	if (NOT DEFINED Boost_ROOT AND NOT "@LIBGS_BOOST_INSTALL_PREFIX@" STREQUAL "")
		set(Boost_ROOT "@LIBGS_BOOST_INSTALL_PREFIX@")
	endif ()
	find_dependency(Boost CONFIG)

elseif (LibGS_ASIO_PROVIDER STREQUAL "EXTERNAL")
	find_package(asio CONFIG QUIET HINTS "@LIBGS_ASIO_INSTALL_PREFIX@")

	if (NOT TARGET @LIBGS_ASIO_PACKAGE_TARGET@)
		find_package(Asio CONFIG QUIET HINTS "@LIBGS_ASIO_INSTALL_PREFIX@")
	endif ()

	if (NOT TARGET @LIBGS_ASIO_PACKAGE_TARGET@)
		find_path(LibGS_ASIO_INCLUDE_DIR
			NAMES asio.hpp
			HINTS "@LIBGS_ASIO_INSTALL_PREFIX@"
			PATH_SUFFIXES include
		)
		if (NOT LibGS_ASIO_INCLUDE_DIR)
			set(LibGS_FOUND FALSE)
			set(LibGS_NOT_FOUND_MESSAGE
				"LibGS was built with external standalone Asio, but asio.hpp was not found."
			)
			return()
		endif ()

		add_library(@LIBGS_ASIO_PACKAGE_TARGET@ INTERFACE IMPORTED)
		set_target_properties(@LIBGS_ASIO_PACKAGE_TARGET@ PROPERTIES
			INTERFACE_INCLUDE_DIRECTORIES "${LibGS_ASIO_INCLUDE_DIR}"
		)
	endif ()
endif ()

set(_libgs_utils_component_requested FALSE)
if (@LIBGS_BUILD_UTILITIES@ AND (NOT LibGS_FIND_COMPONENTS OR
	"utils" IN_LIST LibGS_FIND_COMPONENTS))
	set(_libgs_utils_component_requested TRUE)
endif ()

if (LibGS_SPDLOG_PROVIDER STREQUAL "external" AND _libgs_utils_component_requested)
	find_package(spdlog CONFIG QUIET HINTS "@LIBGS_SPDLOG_INSTALL_PREFIX@")

	if (NOT TARGET @LIBGS_SPDLOG_PACKAGE_TARGET@)
		find_path(LibGS_SPDLOG_INCLUDE_DIR
			NAMES spdlog/spdlog.h
			HINTS "@LIBGS_SPDLOG_INSTALL_PREFIX@"
			PATH_SUFFIXES include
		)
		if (NOT LibGS_SPDLOG_INCLUDE_DIR)
			set(LibGS_FOUND FALSE)
			set(LibGS_NOT_FOUND_MESSAGE
				"LibGS was built with external spdlog, but spdlog/spdlog.h was not found."
			)
			return()
		endif ()

		add_library(@LIBGS_SPDLOG_PACKAGE_TARGET@ INTERFACE IMPORTED)
		set_target_properties(@LIBGS_SPDLOG_PACKAGE_TARGET@ PROPERTIES
			INTERFACE_INCLUDE_DIRECTORIES "${LibGS_SPDLOG_INCLUDE_DIR}"
		)
	endif ()
endif ()

if (@LIBGS_OPENSSL_SUPPORT@)
	# Preserve the OpenSSL selection made while building LibGS.  This matters
	# on Windows hosts that contain both MSVC and MinGW OpenSSL installations:
	# FindOpenSSL can otherwise select libraries built for the wrong ABI.  An
	# explicit consumer OPENSSL_ROOT_DIR always takes precedence, and a removed
	# or non-relocatable build-time prefix is ignored.
	if (NOT DEFINED OPENSSL_ROOT_DIR AND
		NOT LibGS_OPENSSL_INSTALL_PREFIX STREQUAL "" AND
		IS_DIRECTORY "${LibGS_OPENSSL_INSTALL_PREFIX}")
		set(OPENSSL_ROOT_DIR "${LibGS_OPENSSL_INSTALL_PREFIX}")
	endif ()
	find_dependency(OpenSSL)
endif ()

set(_libgs_zlib_component_requested FALSE)

if (NOT LibGS_FIND_COMPONENTS)
	if (@LIBGS_PACKAGE_HTTP_NEEDS_ZLIB@ OR
		@LIBGS_PACKAGE_WEBSOCKET_NEEDS_ZLIB@)
		set(_libgs_zlib_component_requested TRUE)
	endif ()
else ()
	# WebSocket publicly depends on HTTP, so an HTTP compression dependency is
	# also part of a requested WebSocket target's static link closure.
	if (@LIBGS_PACKAGE_HTTP_NEEDS_ZLIB@ AND (
		"http" IN_LIST LibGS_FIND_COMPONENTS OR
		(LibGS_websocket_FOUND AND "websocket" IN_LIST LibGS_FIND_COMPONENTS)
		))
		set(_libgs_zlib_component_requested TRUE)
	endif ()

	if (@LIBGS_PACKAGE_WEBSOCKET_NEEDS_ZLIB@ AND
		"websocket" IN_LIST LibGS_FIND_COMPONENTS)
		set(_libgs_zlib_component_requested TRUE)
	endif ()
endif ()

if (_libgs_zlib_component_requested)
	find_dependency(ZLIB)

	# MinGW scans static archives from left to right.  Some static OpenSSL
	# packages are built with zlib but omit it from OpenSSL::Crypto's imported
	# interface.  Add the missing private edge only for HTTP/WebSocket consumers;
	# core-only consumers must not acquire a zlib dependency.
	if (MINGW AND @LIBGS_BUILD_STATIC@ AND TARGET OpenSSL::Crypto)
		get_target_property(_libgs_openssl_crypto_links
			OpenSSL::Crypto INTERFACE_LINK_LIBRARIES
		)
		if (NOT ZLIB::ZLIB IN_LIST _libgs_openssl_crypto_links)
			set_property(TARGET OpenSSL::Crypto APPEND PROPERTY
				INTERFACE_LINK_LIBRARIES ZLIB::ZLIB)
		endif ()
	endif ()
endif ()

if (@LIBGS_IO_URING_SUPPORT@)
	find_path(LibGS_LIBURING_INCLUDE_DIR NAMES liburing.h)
	find_library(LibGS_LIBURING_LIBRARY NAMES uring)

	if (NOT LibGS_LIBURING_INCLUDE_DIR OR NOT LibGS_LIBURING_LIBRARY)
		set(LibGS_FOUND FALSE)
		set(LibGS_NOT_FOUND_MESSAGE
			"LibGS was built with io_uring support, but liburing was not found."
		)
		return()
	endif ()

	if (NOT TARGET LibGS::uring)
		add_library(LibGS::uring UNKNOWN IMPORTED)
		set_target_properties(LibGS::uring PROPERTIES
			IMPORTED_LOCATION "${LibGS_LIBURING_LIBRARY}"
			INTERFACE_INCLUDE_DIRECTORIES "${LibGS_LIBURING_INCLUDE_DIR}"
		)
	endif ()
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/LibGSTargets.cmake")

# Preserve the source-tree target names for consumers that already use them.
foreach(_libgs_component core coro http websocket utils)
	if (TARGET LibGS::${_libgs_component} AND NOT TARGET gs.${_libgs_component})
		add_library(gs.${_libgs_component} INTERFACE IMPORTED)
		set_property(TARGET gs.${_libgs_component} PROPERTY
			INTERFACE_LINK_LIBRARIES LibGS::${_libgs_component}
		)
	endif ()
endforeach()

unset(_libgs_component)
unset(_libgs_missing_components)
unset(_libgs_missing_components_text)

unset(_libgs_openssl_crypto_links)
unset(_libgs_utils_component_requested)
unset(_libgs_zlib_component_requested)
